{
  "name": "@benomad/msdk-mcp",
  "version": "2.10.0-2.beta",
  "description": "MCP server for the BeNomad MSDK for Android: its API reference and module guides, for AI coding assistants. Offline and read-only. Documents MSDK 2.10.0.2-beta.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "msdk-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src/",
    "data/",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeNomadSAS/mobileSDK-mcp.git"
  },
  "homepage": "https://github.com/BeNomadSAS/mobileSDK-mcp"
}
